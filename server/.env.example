# ═══════════════════════════════════════════════════════════
#  GovJobs Tracker — Server Environment Variables
#  Copy this file to .env and fill in real values
# ═══════════════════════════════════════════════════════════

# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/govjobs?retryWrites=true&w=majority

# JWT — change this to a long random string in production!
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars

# Admin credentials (overrides hardcoded fallback)
ADMIN_EMAIL=admin@govjobs.in
ADMIN_PASSWORD=your_strong_password_here

# Frontend URL (for CORS whitelist in production)
CLIENT_URL=https://your-vercel-app.vercel.app

# Email (SMTP) for reminder notifications — use Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password

# RSS Scheduler interval in hours (default: 6)
FETCH_INTERVAL_HOURS=6
